# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，绝不可提交。
# 只放密钥；行为配置放 configs/*.yaml（见 LEARNING_ROADMAP.md §5.4）

APP_ENV=development
LOG_LEVEL=INFO

# --- LLM（生成侧）---
# deepseek-chat 是别名，实测解析为 deepseek-flash；账号另有 deepseek-v4-pro。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL_EXTRACT=deepseek-chat
LLM_MODEL_GENERATE=deepseek-chat
LLM_MODEL_REVIEW=deepseek-chat
# 扫描件/图片简历与岗位图片录入走它，必须是多模态模型；留空 = 未选型，图片解析会显式报错
# 2026-10-21 选定：DeepSeek 的实验性视觉模型，与文本模型同一个 base_url，无需额外 key
LLM_MODEL_VISION=deepseek-v4-flash-vision-exp

# --- Embedding（DeepSeek 不提供，必须单独选型，见 §7.2）---
# 当前决定：阶段 6 再选型；embedding 缺失时 sqlite-vec 无法入库。
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# --- 数据层（嵌入式 SQLite，无需 Docker）---
DATABASE_URL=sqlite+aiosqlite:///./data/interview_forge.db
UPLOAD_DIR=./data/uploads
# REDIS_URL=redis://localhost:6379/0   # 已弃用：Celery+Redis 由 FastAPI BackgroundTasks 替代

# --- 鉴权 ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- 可观测性（阶段 9，可选：自托管需 Docker，云端则填下面三项）---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
