  "cards": [
    {
      "dot": "cyan",
      "title": "契约与确定性",
      "items": [
        "节点只返回增量；trace / errors 只追加",
        "prompt_version 由 traced() 剥离并记进 trace",
        "parse 只花 1 次 LLM，plan 一次都不调"
      ]
    },
    {
      "dot": "rose",
      "title": "失败与成本边界",
      "items": [
        "可恢复失败写 errors / review_issues；不可恢复抛 AppError",
        "扇出前读 llm.usage，越线抛 BudgetExceededError（429）",
        "中途崩溃：mark_failed，interview 由 running 翻 aborted"
      ]
    }
