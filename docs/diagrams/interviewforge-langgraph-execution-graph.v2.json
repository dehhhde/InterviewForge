        "note": "validate 判出问题才回到 parse，计数由 validate 自增，所以比较用 <=。"
      },
      {
        "id": "fanout",
        "label": "Send 扇出与收尾",
        "focus": [
          "plan",
          "generate",
          "generate_item",
          "review"
        ],
        "note": "一条 plan_item 一个分支，分支只看到 GenerateJob；review 跑完直接落库。"
      }
    ],
